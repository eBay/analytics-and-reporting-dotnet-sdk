<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EBay.AnalyticsAndReporting</RootNamespace>
    <AssemblyName>EBay.AnalyticsAndReporting</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>2.0.0</Version>
    <Authors>eBay</Authors>
    <Description>Analytics and Reporting SDK for eBay APIs</Description>
    <PackageProjectUrl>https://github.com/eBay/analytics-and-reporting-dotnet-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eBay/analytics-and-reporting-dotnet-sdk</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="1.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" />
  </ItemGroup>

</Project>
